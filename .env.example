# Bare hostname of your Auth0 tenant. No scheme, no trailing slash.
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Full URL of your Auth0 tenant's token endpoint. Same tenant as AUTH0_DOMAIN,
# spelled out in full because policy options don't support string
# interpolation around $env(...).
AUTH0_TOKEN_URL=https://your-tenant.us.auth0.com/oauth/token

# Regular Web Application in Auth0, representing the *gateway's* identity
# when it sends MCP clients through Auth0's browser login.
# Callback URL to allow-list in Auth0: https://<gateway-host>/__zuplo/oauth/callback
AUTH0_GATEWAY_CLIENT_ID=
AUTH0_GATEWAY_CLIENT_SECRET=

# Machine-to-Machine Application in Auth0, representing *our MCP server
# calling the downstream echo API* (client-credentials grant), attached on
# the /echo route before it forwards to https://echo.zuplo.io. Authorize it
# for the API you create for AUTH0_ECHO_API_AUDIENCE below.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# Identifier of the Auth0 API representing the downstream echo service
# (Applications > APIs > Create API). https://echo.zuplo.io is Zuplo's public
# reflector demo and doesn't validate this itself — it just echoes back
# whatever Authorization header it receives, which is enough to see the
# exchanged token land in the response. Point this at your own Auth0-checked
# backend instead of echo.zuplo.io for a real deployment.
# Must match the API Identifier you registered in Auth0 EXACTLY, including a
# trailing slash if Auth0 added one for you — the client-credentials request
# fails with "Service not found" on a mismatch.
AUTH0_ECHO_API_AUDIENCE=https://echo.zuplo.io/

# Public base URL of this deployment, used to build the gateway's
# rewritePattern back to its own /internal/echo/mcp route.
# Local dev: http://localhost:9000
GATEWAY_SELF_URL=http://localhost:9000
